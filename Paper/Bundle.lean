/-- [molt_petit::anchors_dense_be]:
    Source: 'src/lib.rs', lines 803:0-830:1 -/
def anchors_dense_be
  {B : Type} {Clause0_Num : Type} {Clause0_Bool : Type} (BackendInst : Backend
  B Clause0_Num Clause0_Bool) (be : B) (all : ChainG Clause0_Num)
  (rest : ChainG Clause0_Num) (lo : Clause0_Num) (t : Clause0_Num)
  (n : Clause0_Num) (q : Clause0_Num) :
  Result Clause0_Bool
  := do
  match rest with
  | ChainG.NilG => BackendInst.bool_const be true
  | ChainG.ConsG b tl =>
    let t1 ← BackendInst.one be
    let u ← BackendInst.add be b.slot t1
    let lt_u_lo ← BackendInst.lt be u lo
    let lo_le_u ← BackendInst.not be lt_u_lo
    let u_plus_n ← BackendInst.add be u n
    let t11 ← BackendInst.add be t t1
    let lt_t1 ← BackendInst.lt be t11 u_plus_n
    let matured ← BackendInst.not be lt_t1
    let cond ← BackendInst.and be lo_le_u matured
    let dense ← window_dense_be BackendInst be q all u n
    let ncond ← BackendInst.not be cond
    let ok1 ← BackendInst.or be ncond dense
    let rest_ok ← anchors_dense_be BackendInst be all tl lo t n q
    BackendInst.and be ok1 rest_ok
