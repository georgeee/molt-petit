def window_count_be
  {B : Type} {Clause0_Num : Type} {Clause0_Bool : Type} (BackendInst : Backend
  B Clause0_Num Clause0_Bool) (be : B) (c : ChainG Clause0_Num)
  (u : Clause0_Num) (len : Clause0_Num) :
  Result Clause0_Num
  := do
  match c with
  | ChainG.NilG => BackendInst.zero be
  | ChainG.ConsG b tl =>
    let lt_lo ← BackendInst.lt be b.slot u
    let ge_u ← BackendInst.not be lt_lo
    let hi ← BackendInst.add be u len
    let lt_hi ← BackendInst.lt be b.slot hi
    let inw ← BackendInst.and be ge_u lt_hi
    let here ← BackendInst.bool_to_num be inw
    let rest ← window_count_be BackendInst be tl u len
    BackendInst.add be here rest
