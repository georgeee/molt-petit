def hashg_eq
  {B : Type} {Clause0_Num : Type} {Clause0_Bool : Type} (BackendInst : Backend
  B Clause0_Num Clause0_Bool) (be : B) (x : HashG Clause0_Num)
  (y : HashG Clause0_Num) :
  Result Clause0_Bool
  := do
  let ea ← BackendInst.eq be x.a y.a
  let eb ← BackendInst.eq be x.b y.b
  let ec ← BackendInst.eq be x.c y.c
  let ed ← BackendInst.eq be x.d y.d
  let eab ← BackendInst.and be ea eb
  let ecd ← BackendInst.and be ec ed
  BackendInst.and be eab ecd

