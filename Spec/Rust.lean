  (c : ChainG Clause0_Num) (u : Clause0_Num) (n : Clause0_Num) :
  Result Clause0_Bool
  := do
  let cnt ← window_count_be BackendInst be c u n
  let lt ← BackendInst.lt be cnt q
  BackendInst.not be lt

/-- [molt_petit::genesis_ok_be]:
