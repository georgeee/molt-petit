def genesis_ok_be
  {B : Type} {Clause0_Num : Type} {Clause0_Bool : Type} (BackendInst : Backend
  B Clause0_Num Clause0_Bool) (be : B) (b : BlockG Clause0_Num) :
  Result Clause0_Bool
  := do
  let t ← BackendInst.zero be
  let h0 ← BackendInst.eq be b.height t
