  BackendInst.and be h0 np

/-- [molt_petit::child_ok_be]:
    Source: 'src/lib.rs', lines 763:0-772:1 -/
def child_ok_be
  {B : Type} {Clause0_Num : Type} {Clause0_Bool : Type} (BackendInst : Backend
  B Clause0_Num Clause0_Bool) (be : B) (parent : BlockG Clause0_Num)
  (child : BlockG Clause0_Num) :
  Result Clause0_Bool
  := do
  let t ← BackendInst.one be
  let succ ← BackendInst.add be parent.height t
  let h_ok ← BackendInst.eq be child.height succ
  let slot_ok ← BackendInst.lt be parent.slot child.slot
  let prev_eq ← hashg_eq BackendInst be child.prev parent.id
  let has ← BackendInst.bool_const be child.has_prev
  let prev_ok ← BackendInst.and be has prev_eq
  let hs ← BackendInst.and be h_ok slot_ok
  BackendInst.and be hs prev_ok

