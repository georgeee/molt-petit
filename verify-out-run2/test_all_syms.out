@sync_rule : ∀ {n : ℕ},
  1 ≤ n →
    ∀ {Sig sk pk : Type} {ops : Molt.SigOps Sig sk pk} {registry : Molt.KeyRegistry pk} {rented : Molt.ByzantineSlots}
      {Stolen : ℕ → ℕ → Prop} {honestSigned : Molt.SigningLog} {now Δ : ℕ} {G : Molt.Block}
      {sc sc' scPrev : Molt.SignedChain Sig} {A : Molt.Block},
      Molt.KeyStealingEUFCMA n n ops registry rented Stolen honestSigned now Δ →
        Molt.SignedHashInjective (Molt.KeyStealingSigned n ops registry) G →
          ∀ {t : ℕ} {tipPrev : Molt.Block},
            Molt.validSignedChainK' n n ops registry scPrev = true →
              List.getLast? (Molt.stripSigs scPrev) = some tipPrev →
                t ≤ tipPrev.slot + n →
                  n < List.length (Molt.stripSigs scPrev) →
                    Molt.blockAt? (Molt.stripSigs scPrev) (List.length (Molt.stripSigs scPrev) - 1 - n) = some A →
                      now ≤ t + n →
                        A ∈ Molt.stripSigs sc →
                          A ∈ Molt.stripSigs sc' →
                            (∀ (u : ℕ),
                                now < u + 5 * n →
                                  (Molt.badSlotsIn (badKeyrot n n rented Stolen (Molt.stripSigs sc)) u n).card ≤
                                    faultBudget n) →
                              Molt.validSignedChainK' n n ops registry sc = true →
                                Molt.validSignedChainK' n n ops registry sc' = true →
                                  ∀ {sTip sTip' : Molt.Block},
                                    List.getLast? (Molt.stripSigs sc) = some sTip →
                                      List.getLast? (Molt.stripSigs sc') = some sTip' →
                                        now ≤ sTip.slot + Δ →
                                          now ≤ sTip'.slot + Δ →
                                            n < List.length (Molt.stripSigs sc) →
                                              n < List.length (Molt.stripSigs sc') →
                                                sTip.height = sTip'.height →
                                                  ∀ {B B' : Molt.Block},
                                                    Molt.blockAt? (Molt.stripSigs sc)
                                                          (List.length (Molt.stripSigs sc) - 1 - n) =
                                                        some B →
                                                      Molt.blockAt? (Molt.stripSigs sc')
                                                            (List.length (Molt.stripSigs sc') - 1 - n) =
                                                          some B' →
                                                        B = B'
