        P.card ≤ (Molt.badSlotsIn (badKeyrot n Δconf rented Stolen c₀) u n).card
@cert_max_sync_period : ∀ {n Δconf F : ℕ},
  1 ≤ n →
    n ≤ Δconf →
      ∀ {Sig sk pk : Type} {ops : Molt.SigOps Sig sk pk} {registry : Molt.KeyRegistry pk} {rented : Molt.ByzantineSlots}
        {Stolen : ℕ → ℕ → Prop} {honestSigned : Molt.SigningLog} {now Δ : ℕ} {G A : Molt.Block} {clP : Molt.CertClaim}
        {flP : ℕ → ℕ} {s₁P : Molt.Block} {srestP : Molt.Chain} {tipPrev : Molt.Block} {t : ℕ},
        Molt.KeyStealingEUFCMA n Δconf ops registry rented Stolen honestSigned now Δ →
          Molt.SignedHashInjective (Molt.SignedDeclared n ops registry) G →
            Molt.AcceptedSuffixK n (Molt.SignedDeclared n ops registry) G clP flP s₁P srestP tipPrev →
              t ≤ tipPrev.slot + n →
                n < (s₁P :: srestP).length →
                  Molt.blockAt? (s₁P :: srestP) ((s₁P :: srestP).length - 1 - n) = some A →
                    now ≤ t + F →
                      ∀ {cl cl' : Molt.CertClaim} {fl fl' : ℕ → ℕ} {s₁ s₁' : Molt.Block} {srest srest' : Molt.Chain}
                        {sTip sTip' : Molt.Block},
                        Molt.AcceptedSuffixK n (Molt.SignedDeclared n ops registry) G cl fl s₁ srest sTip →
                          Molt.AcceptedSuffixK n (Molt.SignedDeclared n ops registry) G cl' fl' s₁' srest' sTip' →
                            now ≤ sTip.slot + Δ →
                              now ≤ sTip'.slot + Δ →
                                A ∈ s₁ :: srest →
                                  A ∈ s₁' :: srest' →
                                    (∀ (c : Molt.Chain),
                                        Molt.AttestedHistoryK n Δconf ops registry G cl.tipHeight (s₁ :: srest) c →
                                          ∀ (u : ℕ),
                                            now < u + F + 4 * n →
                                              (Molt.badSlotsIn (badKeyrot n Δconf rented Stolen c) u n).card ≤
                                                faultBudget n) →
                                      ∀ {i i' : ℕ} {B B' : Molt.Block},
                                        Molt.blockAt? (s₁ :: srest) i = some B →
                                          Molt.blockAt? (s₁' :: srest') i' = some B' →
                                            cl.tipHeight + 1 + i = cl'.tipHeight + 1 + i' →
                                              i + n < (s₁ :: srest).length → i' + n < (s₁' :: srest').length → B = B'
