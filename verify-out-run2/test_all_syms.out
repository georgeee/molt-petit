@client_refresh_rule : ∀ {n Δconf : ℕ},
  1 ≤ n →
    n ≤ Δconf →
      ∀ {Sig sk pk : Type} {ops : Molt.SigOps Sig sk pk} {registry : Molt.KeyRegistry pk} {rented : Molt.ByzantineSlots}
        {Stolen : ℕ → ℕ → Prop} {honestSigned : Molt.SigningLog} {now Δ : ℕ} {G : Molt.Block}
        {sc sc' : Molt.SignedChain Sig} {A : Molt.Block} {H : ℕ},
        Molt.KeyStealingEUFCMA n Δconf ops registry rented Stolen honestSigned now Δ →
          Molt.SignedHashInjective (Molt.KeyStealingSigned n ops registry) G →
            A ∈ Molt.stripSigs sc →
              A ∈ Molt.stripSigs sc' →
                now ≤ A.slot + H →
                  (∀ (u : ℕ),
                      now < u + n + H →
                        (Molt.badSlotsIn (badKeyrot n Δconf rented Stolen (Molt.stripSigs sc)) u n).card ≤
                          faultBudget n) →
                    Molt.validSignedChainK' n Δconf ops registry sc = true →
                      Molt.validSignedChainK' n Δconf ops registry sc' = true →
                        ∀ {sTip sTip' : Molt.Block},
                          List.getLast? (Molt.stripSigs sc) = some sTip →
                            List.getLast? (Molt.stripSigs sc') = some sTip' →
                              now ≤ sTip.slot + Δ →
                                now ≤ sTip'.slot + Δ →
                                  n < List.length (Molt.stripSigs sc) →
                                    n < List.length (Molt.stripSigs sc') →
                                      sTip.height = sTip'.height →
                                        ∀ {B B' : Molt.Block},
                                          Molt.blockAt? (Molt.stripSigs sc) (List.length (Molt.stripSigs sc) - 1 - n) =
                                              some B →
                                            Molt.blockAt? (Molt.stripSigs sc')
                                                  (List.length (Molt.stripSigs sc') - 1 - n) =
                                                some B' →
                                              B = B'
