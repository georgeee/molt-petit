@Molt.sched_recent_tip_ancestor_agreement_horizon : ∀ {n : ℕ},
  1 ≤ n →
    ∀ {schedule : ℕ → ℕ} {Sig sk pk : Type} {ops : MoltPetit.Model.SigOps Sig sk pk}
      {registry : MoltPetit.Model.KeyRegistry pk} {rented : MoltPetit.Model.ByzantineSlots} {Stolen : ℕ → ℕ → Prop}
      {honestSigned : ℕ → ℕ → Option MoltPetit.Model.Block} {now Δ : ℕ} {G : MoltPetit.Model.Block}
      {sc sc' : MoltPetit.Model.SignedChain Sig},
      MoltPetit.Model.SchedUnforgeable n schedule ops registry rented Stolen honestSigned now Δ →
        MoltPetit.Model.SignedHashInjective (MoltPetit.Model.SignedDeclared n ops registry) G →
          ∀ {H : ℕ},
            MoltPetit.Model.ByzantineBoundedFrom H n (MoltPetit.Model.badSched n schedule rented Stolen) →
              MoltPetit.Model.validSignedChainSched n schedule ops registry sc = true →
                MoltPetit.Model.validSignedChainSched n schedule ops registry sc' = true →
                  ∀ {sTip sTip' : MoltPetit.Model.Block},
                    List.getLast? (MoltPetit.Model.stripSigs sc) = some sTip →
                      List.getLast? (MoltPetit.Model.stripSigs sc') = some sTip' →
                        now ≤ sTip.slot + Δ →
                          now ≤ sTip'.slot + Δ →
                            n < List.length (MoltPetit.Model.stripSigs sc) →
                              n < List.length (MoltPetit.Model.stripSigs sc') →
                                H + n ≤ sTip.slot + 1 →
                                  H + n ≤ sTip'.slot + 1 →
                                    sTip.height = sTip'.height →
                                      ∀ {B B' : MoltPetit.Model.Block},
                                        MoltPetit.Model.blockAt? (MoltPetit.Model.stripSigs sc)
                                              (List.length (MoltPetit.Model.stripSigs sc) - 1 - n) =
                                            some B →
                                          MoltPetit.Model.blockAt? (MoltPetit.Model.stripSigs sc')
                                                (List.length (MoltPetit.Model.stripSigs sc') - 1 - n) =
                                              some B' →
                                            B = B'
