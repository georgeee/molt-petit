    ∀ {schedule : ℕ → ℕ} {Sig sk pk : Type} {ops : MoltPetit.Model.SigOps Sig sk pk}
      {registry : MoltPetit.Model.KeyRegistry pk} {rented : MoltPetit.Model.ByzantineSlots} {Stolen : ℕ → ℕ → Prop}
      {honestSigned : ℕ → ℕ → Option MoltPetit.Model.Block} {now Δ : ℕ} {G : MoltPetit.Model.Block},
      MoltPetit.Model.SchedCoreUnforgeable n schedule ops registry rented Stolen honestSigned now Δ →
        MoltPetit.Model.SignedHashInjective (MoltPetit.Model.SignedDeclared n ops registry) G →
          MoltPetit.Model.ByzantineBounded n (MoltPetit.Model.badSched n schedule rented Stolen) →
            ∀ {cl cl' : MoltPetit.Model.CertClaim},
              MoltPetit.Model.GroundedCertSched n schedule (MoltPetit.Model.SignedDeclared n ops registry) G cl →
                MoltPetit.Model.GroundedCertSched n schedule (MoltPetit.Model.SignedDeclared n ops registry) G cl' →
                  ∀ {s₁ s₁' : MoltPetit.Model.Block} {srest srest' : MoltPetit.Model.Chain}
                    {sTip sTip' : MoltPetit.Model.Block},
                    (s₁ :: srest).getLast? = some sTip →
                      (s₁' :: srest').getLast? = some sTip' →
                        s₁.height = cl.tipHeight + 1 ∧ cl.tipSlot < s₁.slot ∧ s₁.prev = some cl.tipId →
                          MoltPetit.Model.linksOk (s₁ :: srest) = true →
                            (∀ (u : ℕ),
                                ↑cl.tipSlot + 2 - ↑n ≤ ↑u →
                                  u + n ≤ sTip.slot + 1 →
                                    MoltPetit.Model.quorum n ≤
                                      MoltPetit.Model.windowCount (cl.tail ++ s₁ :: srest) u n) →
                              MoltPetit.Model.schedPinned schedule (s₁ :: srest) = true →
                                (∀ B ∈ s₁ :: srest, MoltPetit.Model.SignedDeclared n ops registry B) →
                                  s₁'.height = cl'.tipHeight + 1 ∧ cl'.tipSlot < s₁'.slot ∧ s₁'.prev = some cl'.tipId →
                                    MoltPetit.Model.linksOk (s₁' :: srest') = true →
                                      (∀ (u : ℕ),
                                          ↑cl'.tipSlot + 2 - ↑n ≤ ↑u →
                                            u + n ≤ sTip'.slot + 1 →
                                              MoltPetit.Model.quorum n ≤
                                                MoltPetit.Model.windowCount (cl'.tail ++ s₁' :: srest') u n) →
                                        MoltPetit.Model.schedPinned schedule (s₁' :: srest') = true →
                                          (∀ B ∈ s₁' :: srest', MoltPetit.Model.SignedDeclared n ops registry B) →
                                            now ≤ sTip.slot + Δ →
                                              now ≤ sTip'.slot + Δ →
                                                ∀ {i i' : ℕ} {B B' : MoltPetit.Model.Block},
                                                  MoltPetit.Model.blockAt? (s₁ :: srest) i = some B →
                                                    MoltPetit.Model.blockAt? (s₁' :: srest') i' = some B' →
                                                      cl.tipHeight + 1 + i = cl'.tipHeight + 1 + i' →
                                                        i + n < (s₁ :: srest).length →
                                                          i' + n < (s₁' :: srest').length → B = B'
