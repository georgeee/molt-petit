+/-- The object name of a `scrut.field` definedness-test subject (either
+    operand order): a plain (non-computed) member access on a bare
+    identifier tested against `null`/`undefined`. This is exactly the shape
+    `substMemberAccessExpr` rewrites to the arm's `field` binder inside a
+    switch over `scrut`, where the identifier-subject lowering applies. -/
+private def definednessTestScrutMemberSubject? : Expression → Option String
+  | .binaryExpr _ op l r =>
+      let nullishEqOp := match op with
+        | .seq | .sneq | .eq | .neq => true
+        | _ => false
+      if nullishEqOp then
+        let isNullish : Expression → Bool := fun
+          | .literal _ .null _ => true
+          | .identifier _ "undefined" => true
+          | _ => false
+        let subjOf : Expression → Expression → Option String := fun a b =>
+          match a with
+          | .memberExpr _ (.identifier _ obj) (.identifier _ _) false _ =>
+              if isNullish b && !isNullish a then some obj else none
+          | _ => none
+        subjOf l r <|> subjOf r l
+      else none
+  | _ => none
+
